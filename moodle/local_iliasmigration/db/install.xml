<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/iliasmigration/db" VERSION="20261004" COMMENT="XMLDB file for local_iliasmigration"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_iliasmigration_map" COMMENT="Persistent mapping between ILIAS source objects and Moodle targets">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="sourcelms" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="ILIAS" SEQUENCE="false"/>
        <FIELD NAME="sourceinstance" TYPE="char" LENGTH="128" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="sourceversion" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="sourcecourse" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sourceref" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sourceobj" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="targettype" TYPE="char" LENGTH="32" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="targetid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="16" NOTNULL="true" DEFAULT="PENDING" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="source_target_unique" TYPE="unique" FIELDS="sourcelms,sourceinstance,sourcecourse,sourceref,targettype"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="sourceobj_idx" UNIQUE="false" FIELDS="sourceobj"/>
        <INDEX NAME="target_idx" UNIQUE="false" FIELDS="targettype,targetid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_iliasmigration_job" COMMENT="Operator migration jobs">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="status" TYPE="char" LENGTH="24" NOTNULL="true" DEFAULT="NEW" SEQUENCE="false"/>
        <FIELD NAME="failurepolicy" TYPE="char" LENGTH="16" NOTNULL="true" DEFAULT="pause" SEQUENCE="false"/>
        <FIELD NAME="sourcefilename" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="sourcehash" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="packagepath" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="migrationjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="categorypath" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="categoryid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="createdby" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="summaryjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="lasterror" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timestarted" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timefinished" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="createdby_fk" TYPE="foreign" FIELDS="createdby" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="status_idx" UNIQUE="false" FIELDS="status"/>
        <INDEX NAME="createdby_idx" UNIQUE="false" FIELDS="createdby"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_iliasmigration_step" COMMENT="Ordered operator migration job steps">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="jobid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sequence" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="stepkey" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="label" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="24" NOTNULL="true" DEFAULT="PENDING" SEQUENCE="false"/>
        <FIELD NAME="critical" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="skippable" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="ignored" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="attempts" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="contextjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="resultjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="errormessage" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timestarted" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timefinished" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="job_fk" TYPE="foreign" FIELDS="jobid" REFTABLE="local_iliasmigration_job" REFFIELDS="id"/>
        <KEY NAME="job_step_unique" TYPE="unique" FIELDS="jobid,stepkey"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="job_status_idx" UNIQUE="false" FIELDS="jobid,status"/>
        <INDEX NAME="job_sequence_idx" UNIQUE="false" FIELDS="jobid,sequence"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_iliasmigration_log" COMMENT="Persistent operator migration event log">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="jobid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="stepid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="level" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="INFO" SEQUENCE="false"/>
        <FIELD NAME="eventcode" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="message" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="contextjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="job_fk" TYPE="foreign" FIELDS="jobid" REFTABLE="local_iliasmigration_job" REFFIELDS="id"/>
        <KEY NAME="step_fk" TYPE="foreign" FIELDS="stepid" REFTABLE="local_iliasmigration_step" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="job_time_idx" UNIQUE="false" FIELDS="jobid,timecreated"/>
        <INDEX NAME="level_idx" UNIQUE="false" FIELDS="level"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
